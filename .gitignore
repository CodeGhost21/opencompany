# Rust build artifacts
target/
# Tauri's generated permission/ACL schemas. Regenerated by every build, so a
# committed copy is churn that conflicts on every branch. The stale
# `frontend/src-tauri/` path is kept because older branches still write there.
src-tauri/gen/
frontend/src-tauri/gen/
*.profraw
*.profdata
lcov.info

# Local configuration
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
.idea/
.vscode/

# agent worktrees (isolation)
.claude/worktrees/

# Local worktree files
worktrees/*
!worktrees/.gitkeep

# Local dev cargo path-override (points at a sibling openhuman checkout)
.cargo/config.toml

# Instance runtime state, written into the data root — which is the repo root
# when a `serve` runs with neither OPENCOMPANY_DATA_DIR nor HOME set. A
# committed `instance-id` would hand every clone the same public identity,
# which is the one thing that file exists not to do.
instance-id
.lock
